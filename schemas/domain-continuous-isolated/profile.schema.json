{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openpq:owned-domain-continuous-isolated:profile:v1",
  "type": "object",
  "required": [
    "contract_version",
    "environment_id",
    "dataset_id",
    "domain",
    "fixture_only",
    "operator_principal_ids",
    "artifact_refs",
    "producer",
    "reference_policy"
  ],
  "properties": {
    "contract_version": {
      "const": "openpq-owned-domain-continuous-reference-isolated-v1"
    },
    "environment_id": {
      "const": "isolated-test"
    },
    "dataset_id": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "weather",
        "weather_forecast",
        "weather_marine",
        "weather_cloud",
        "weather_compact",
        "weather_meta",
        "weather_manifest",
        "airport",
        "transit",
        "nearme"
      ]
    },
    "fixture_only": {
      "const": false
    },
    "operator_principal_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,128}$"
      }
    },
    "artifact_refs": {
      "type": "object",
      "required": [
        "rule",
        "config",
        "policy",
        "schema"
      ],
      "properties": {
        "rule": {
          "type": "object",
          "required": [
            "hash"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "required": [
            "hash"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "required": [
            "hash"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "schema": {
          "type": "object",
          "required": [
            "hash"
          ],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source_kind",
            "repository",
            "path"
          ],
          "properties": {
            "source_kind": {
              "const": "OWNER_REPOSITORY_SNAPSHOT"
            },
            "repository": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "source_kind",
            "url"
          ],
          "properties": {
            "source_kind": {
              "const": "OWNER_PUBLIC_RUNTIME"
            },
            "url": {
              "enum": [
                "https://jotrip-airport-live.kenzuko.workers.dev",
                "https://openphuquoc.com/weather/data/weather-runtime/current.json",
                "https://openphuquoc.com/weather/data/weather-runtime/forecast.json",
                "https://openphuquoc.com/weather/data/weather-runtime/marine.json",
                "https://openphuquoc.com/weather/data/weather-runtime/cloud.json",
                "https://openphuquoc.com/weather/data/weather-runtime/compact.json",
                "https://openphuquoc.com/weather/data/weather-runtime/meta.json",
                "https://openphuquoc.com/data/views/location-index.json"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "reference_policy": {
      "type": "object",
      "required": [
        "lease_ms",
        "max_snapshot_age_ms",
        "future_skew_ms"
      ],
      "properties": {
        "lease_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_snapshot_age_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2678400000
        },
        "future_skew_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
