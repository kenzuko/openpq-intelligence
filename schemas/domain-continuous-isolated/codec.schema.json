{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openpq:owned-domain-continuous-isolated:codec:v1",
  "type": "object",
  "required": [
    "encoding",
    "base64",
    "uncompressed_bytes",
    "sha256"
  ],
  "properties": {
    "encoding": {
      "const": "GZIP_BASE64"
    },
    "base64": {
      "type": "string",
      "maxLength": 160000,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "uncompressed_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1500000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
