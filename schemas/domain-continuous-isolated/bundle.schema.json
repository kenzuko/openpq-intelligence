{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openpq:owned-domain-continuous-isolated:bundle:v1",
  "type": "object",
  "required": [
    "contract_version",
    "pin",
    "encoded_source"
  ],
  "properties": {
    "contract_version": {
      "const": "openpq-owned-domain-continuous-bundle-isolated-v1"
    },
    "pin": {
      "type": "object",
      "required": [
        "source_kind",
        "source_pointer",
        "payload_sha256",
        "git_blob_sha"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "OWNER_REPOSITORY_SNAPSHOT",
            "OWNER_PUBLIC_RUNTIME"
          ]
        },
        "source_pointer": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "repository",
                "commit_sha",
                "path"
              ],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "enum": [
                    "https://jotrip-airport-live.kenzuko.workers.dev",
                    "https://openphuquoc.com/weather/data/weather-runtime/current.json",
                    "https://openphuquoc.com/weather/data/weather-runtime/forecast.json",
                    "https://openphuquoc.com/weather/data/weather-runtime/marine.json",
                    "https://openphuquoc.com/weather/data/weather-runtime/cloud.json",
                    "https://openphuquoc.com/weather/data/weather-runtime/compact.json",
                    "https://openphuquoc.com/weather/data/weather-runtime/meta.json",
                    "https://openphuquoc.com/data/views/location-index.json"
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "git_blob_sha": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "encoded_source": {
      "type": "object",
      "required": [
        "encoding",
        "base64",
        "uncompressed_bytes",
        "sha256"
      ],
      "properties": {
        "encoding": {
          "const": "GZIP_BASE64"
        },
        "base64": {
          "type": "string",
          "maxLength": 160000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "uncompressed_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
